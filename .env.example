# DevForge Root Environment Configuration Example

# Server Environment Variables (placed in server/.env)
PORT=5000
NODE_ENV=development

# MongoDB Connection (Local or MongoDB Atlas)
# Local:
MONGODB_URI=mongodb://127.0.0.1:27017/devforge
# MongoDB Atlas Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/devforge?retryWrites=true&w=majority

JWT_SECRET=devforge_super_secure_jwt_secret_key_2026_production_grade
CLIENT_URL=http://localhost:5173

# Platform Admin Seed Credentials
ADMIN_EMAIL=admin@devforge.io
ADMIN_PASSWORD=Admin@DevForge2026!
ADMIN_NAME=Platform Administrator

# AI API Key (Optional - Smart fallback works out-of-the-box without key)
GEMINI_API_KEY=

# Client Environment Variables (placed in client/.env, optional)
VITE_API_URL=
